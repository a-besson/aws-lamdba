# KICS configuration — scanned IaC: the Terraform stacks of the four samples.
# Accepted findings are ignored INLINE next to the resource (`# kics-scan ignore-line` /
# `# kics-scan disable=<query-id>`) with the reason as a comment — never globally here.
fail-on:
  - high
  - critical
# Build output, IDE settings and provider binaries are not repository code
exclude-paths:
  - /path/.git
  - /path/.idea
  - /path/quarkus-lambda/target
  - /path/quarkus-lambda-api-gateway-rest/target
  - /path/springboot-lambda/target
  - /path/springboot-lambda-api-gateway-rest/target
  - /path/quarkus-lambda/terraform/.terraform
  - /path/quarkus-lambda-api-gateway-rest/terraform/.terraform
  - /path/springboot-lambda/terraform/.terraform
  - /path/springboot-lambda-api-gateway-rest/terraform/.terraform
  - /path/infra/apigateway-account/terraform/.terraform
  - /path/infra/state-bucket/terraform/.terraform
